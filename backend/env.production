# Production environment variables for Render deployment
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info

# Vector database settings
VECTOR_DB_PATH=/opt/render/project/src/chroma_db
LOCAL_BUCKET_DIR=/opt/render/project/src/rag-documents

# LLM settings - Option A: Using Ollama service on Render (memory issues on free tier)
# LLM_API_KEY=
# LLM_BASE_URL=https://rag-chatbot-back.onrender.com
# LLM_DEFAULT_MODEL=llama3.2:3b
# LLM_DEFAULT_TEMPERATURE=0.1
# LLM_DEFAULT_MAX_TOKENS=2000

# LLM settings - Option B: Using OpenAI API (recommended - no memory issues)
LLM_API_KEY=sk-your-openai-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_DEFAULT_MODEL=gpt-3.5-turbo
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_TEMPERATURE=0.1
LLM_DEFAULT_MAX_TOKENS=2000

# CORS settings
CORS_ORIGINS=["https://rag-chatbot-frontend.onrender.com"]

# Memory optimization
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
