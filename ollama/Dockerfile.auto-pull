FROM ollama/ollama:latest

# Create startup script inline (avoids COPY issues)
RUN echo '#!/bin/bash\n\
set -e\n\
echo "Starting Ollama server..."\n\
/bin/ollama serve &\n\
OLLAMA_PID=$!\n\
\n\
echo "Waiting for Ollama to initialize..."\n\
sleep 10\n\
\n\
# Wait for Ollama to be ready\n\
for i in {1..30}; do\n\
  if curl -s http://localhost:11434/api/tags > /dev/null 2>&1; then\n\
    echo "Ollama is ready!"\n\
    break\n\
  fi\n\
  echo "Waiting for Ollama to respond... ($i/30)"\n\
  sleep 2\n\
done\n\
\n\
# Pull the model if not already available\n\
echo "Checking for model llama3.2:3b..."\n\
if ! /bin/ollama list | grep -q "llama3.2:3b"; then\n\
  echo "Model not found. Pulling llama3.2:3b..."\n\
  echo "This may take several minutes (model is ~2GB)..."\n\
  /bin/ollama pull llama3.2:3b || echo "Warning: Model pull encountered an issue"\n\
  echo "Model pull completed!"\n\
else\n\
  echo "Model llama3.2:3b already exists!"\n\
fi\n\
\n\
# Verify model is available\n\
echo "Available models:"\n\
/bin/ollama list\n\
\n\
echo "Ollama server is running with model llama3.2:3b ready!"\n\
wait $OLLAMA_PID\n\
' > /start.sh && chmod +x /start.sh

# Set environment variables for Render
ENV OLLAMA_HOST=0.0.0.0:$PORT

# Expose the port (Render will set PORT automatically)
EXPOSE $PORT

# Use startup script that pulls model automatically
CMD ["/start.sh"]

